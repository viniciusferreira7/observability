# Garage (S3-compatible object storage)
# RPC secret: openssl rand -hex 32
GARAGE_RPC_SECRET=your_rpc_secret_hex32
# Admin token: openssl rand -base64 32
GARAGE_ADMIN_TOKEN=your_admin_token
# Access key: must be "GK" + 24 hex chars  ->  echo GK$(openssl rand -hex 12)
GARAGE_ACCESS_KEY=GKyour24hexcharaccesskeyid
# Secret key: 64 hex chars  ->  openssl rand -hex 32
GARAGE_SECRET_KEY=your_secret_key_hex64

# Disabled login
GF_AUTH_ANONYMOUS_ENABLED=false

# Credentials
GF_SECURITY_ADMIN_USER=your_admin_user
GF_SECURITY_ADMIN_PASSWORD=your_admin_password

# Role
GF_AUTH_ANONYMOUS_ORG_ROLE=Admin

# Embedding
GF_SECURITY_ALLOW_EMBEDDING=true